// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String //@db.Text
  email         String
  emailVerified Boolean      @default(false)
  image         String? //@db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  recipes       Recipe[]
  recipeLikes   RecipeLike[]
  cookbooks     Cookbook[]
  chat          Chat[]

  // The household this user belongs to. A user belongs to at most one (or none). Leaving a
  // household is just setting this to null; the household only disappears when it has no members.
  household      Household?        @relation("HouseholdMembers", fields: [householdId], references: [id], onDelete: SetNull)
  householdId    String?
  // Informational for now (no roles): who created the household.
  ownedHousehold Household?        @relation("HouseholdOwner")
  meals          MealPlanEntry[]
  invitesSent    HouseholdInvite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Category {
  MAIN_COURSE
  DESSERT
  DRINK
  STARTER
  SNACK
  BREAKFAST
}

model Recipe {
  id              String     @id @default(cuid())
  published       Boolean    @default(true)
  slug            String     @unique
  imageUrl        String?
  defaultServings Int
  likesCount      Int        @default(0)
  difficulty      Difficulty @default(EASY)
  category        Category   @default(MAIN_COURSE)

  // Language the author wrote the recipe in. Its translation row is the authoritative text.
  sourceLocale String @default("en")

  // Time in minutes
  preparationTime Int
  cookingTime     Int
  restingTime     Int

  // Nutritional information per serving
  calories      Int
  carbohydrates Int
  protein       Int
  fat           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients     Ingredient[]
  steps           Step[]
  tags            RecipeTag[]
  likes           RecipeLike[]
  cookbooks       CookbookRecipe[]
  translations    RecipeTranslation[]
  mealPlanEntries MealPlanEntry[]

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  @@map("recipe")
}

/**
 * Localized text of a recipe. Every locale holds the title, description, ingredient names and
 * step descriptions for that language; quantities, units, times and metadata stay on the
 * locale-independent models. Ingredient/step text is keyed by `order` because the structural
 * rows are deleted and recreated on every save, so their ids do not survive an edit.
 */
model RecipeTranslation {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String
  ingredients Json // [{ order: number, name: string }]
  steps       Json // [{ order: number, description: string }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recipeId, locale])
  @@index([locale, title])
  @@map("recipe_translation")
}

enum Unit {
  GRAM
  KILOGRAM
  LITER
  MILLILITER
  CUP
  TABLESPOON
  TEASPOON
  UNIT
}

model Ingredient {
  id        String   @id @default(cuid())
  quantity  Decimal  @db.Decimal(10, 3)
  unit      Unit
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  @@map("ingredient")
}

model Step {
  id        String   @id @default(cuid())
  order     Int
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  @@map("step")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes RecipeTag[]

  @@index([name])
  @@map("tag")
}

model RecipeTag {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String

  @@id([recipeId, tagId])
  @@map("recipe_tag")
}

model RecipeLike {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  @@id([userId, recipeId])
  @@map("recipe_like")
}

model Cookbook {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  recipes CookbookRecipe[]

  @@index([name])
  @@map("cookbook")
}

model CookbookRecipe {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  cookbookId String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId   String

  @@id([cookbookId, recipeId])
  @@map("cookbook_recipe")
}

/**
 * A group of people sharing a meal plan. A user belongs to at most one household at a time.
 * Meals are shared with every member of the household they point to; meals without a household
 * are private to their creator.
 */
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who created the household. Informational for now (there are no roles); kept for future use.
  ownerId String? @unique
  owner   User?   @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  members User[]            @relation("HouseholdMembers")
  meals   MealPlanEntry[]
  invites HouseholdInvite[]

  @@index([name])
  @@map("household")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/**
 * An invitation to join a household, addressed to an email. It does not require the invitee to
 * have an account yet: the token is what proves the invitation.
 */
model HouseholdInvite {
  id        String       @id @default(cuid())
  email     String
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById String

  @@index([email])
  @@index([householdId])
  @@map("household_invite")
}

/**
 * A recipe planned for a specific day. `householdId` is the sharing switch: with a household the
 * meal is visible to every member, without it the meal is private to `createdBy`. It is stored on
 * the row (not derived from the creator's current household) so that leaving a household does not
 * drag the meal away from the other members.
 */
model MealPlanEntry {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  order     Int      @default(0)
  servings  Int?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String?
  recipe      Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId    String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  @@index([householdId, date])
  @@index([createdById, date])
  @@index([recipeId])
  @@map("meal_plan_entry")
}

// Models for AI Chat
model Chat {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("chat")
}

model Message {
  id        String      @id @default(cuid())
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("message")
}

enum MessageRole {
  USER
  ASSISTANT
}

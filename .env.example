# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# Canonical origin of the site, without a trailing slash. Search engines are told that every
# page lives here: canonicals, hreflang, the sitemap, robots.txt and Open Graph all use it.
# Only change it if the site moves to another domain.
NEXT_PUBLIC_SITE_URL="https://mantelazul.com"

# Google sign-in (optional: the button is hidden while these are empty).
# Create an OAuth client in the Google Cloud console and add
# http://localhost:3000/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI: chat, embeddings and image generation.
OPENAI_API_KEY=""

# Dictation in the chat (optional: the microphone button is hidden while this is empty).
# Create an API key in the Groq console. The free plan covers a few hours of audio a day.
GROQ_API_KEY=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/mantelazul"

# Chroma (vector database used for recipe RAG)
# Start a local server with `pnpm chroma:dev` (persists to ./.chroma via SQLite).
CHROMA_URL="http://localhost:8000"

# Chroma Cloud (production). Set CHROMA_API_KEY to switch from CHROMA_URL to the cloud client.
# CHROMA_HOST is the region endpoint, e.g. "europe-west1.gcp.trychroma.com".
CHROMA_HOST=""
CHROMA_API_KEY=""
CHROMA_TENANT=""
CHROMA_DATABASE=""

# Cloudinary (recipe images and uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (verification and password reset email)
RESEND_API_KEY=""

# Langfuse tracing (optional: without both keys the instrumentation does nothing).
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# Only needed for another region or a self-hosted instance.
LANGFUSE_BASE_URL=""
